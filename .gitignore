# Build output
/target
**/*.exe
**/*.pdb
**/*.zip

# Visual Studio / IDE
/.vs
*.user
*.suo
*.VC.db
*.VC.opendb

# Local scratch
*.log
/tmp/

# Build outputs of `build.rs`'s icon block (P8): derived from assets/logo/logo.png
# on every build, and a diff of a generated 132 KB ICO is not a review of
# anything. `logo.png` itself IS tracked -- it is the source.
/assets/logo/logo.ico
/assets/logo/icon.rc

# Assistant workspace data (session notes, memory). Local to this machine.
/.workbuddy-ai/

# NOTE: docs/reference/ is a READ-ONLY vendored baseline (spec Q18).
# Do NOT add patterns that would exclude it.

# Python bytecode from the tools/ scripts
__pycache__/
*.pyc
