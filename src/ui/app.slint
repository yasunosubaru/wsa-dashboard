// SPDX-License-Identifier: GPL-3.0-only

// Root component, ported from the reference's src/ui/app.slint
// (wsl-dashboard 0.12.0, GPL-3.0-only).
//
// P0 shipped a placeholder -- a frameless root would have had no chrome to draw
// on and nothing to show, which makes a phase un-screenshotable. P2 added the
// first tab on its own. **P3 is the shell**: `no-frame` + `TitleBar` +
// `Sidebar` + the opacity tab switch, all together, because they only make
// sense together -- a frameless window with no replacement title bar is a
// window you cannot move or close.
//
//   reference feature        status
//   -----------------------  ---------------------------------------------
//   no-frame + transparent   this change
//   window + TitleBar        this change
//   sidebar + nine tabs      this change; eight of the nine have no page yet
//   modal manager            P5, with the first dialog that uses it. Measured,
//                            not remembered: every reference call site is in
//                            components/dialogs/**, and the earliest of those
//                            (move/compress) is P5.
//   AppI18n / theme wiring   P6, with the full i18n table.
//
// The window TITLE stays in the reference's exact form because the
// single-instance handshake matches on it (docs/MAPPING.md section 2.1).
// `no-frame` hides the caption but does not change `GetWindowText`, so the
// string still answers a second instance asking who is already open -- which is
// why `runner` keeps overriding it with the application name.

import { Theme, Distro, AppInfo, AppI18n, AppApi, DeviceTarget, DeviceProp, Information, StorageImageUI, PortProxyRuleUI, SettingsStrings, AboutStrings } from "theme.slint";
// ★ The reference re-exports its globals from the root (reference
//    `src/ui/app.slint:43`) -- that is what puts `AppI18n` / `AppInfo` in the
//    generated Rust re-export list, and therefore what makes
//    `app.global::<AppI18n>()` in `app::runner` resolve. The structs are here
//    for the same reason: `handlers/device.rs` has to build them.
export { Theme, Distro, AppInfo, AppI18n, AppApi, DeviceTarget, DeviceProp }
import { MainView } from "views/main_view.slint";
import { AddInstanceView } from "views/add_view.slint";
import { DeviceView } from "views/device_view.slint";
import { DiskView } from "views/disk_view.slint";
import { NetworkView } from "views/network/mod.slint";
import { SettingsView } from "views/settings/mod.slint";
import { AboutView } from "views/about_view.slint";
import { TaskStatusToast } from "components/task_status_toast.slint";
import { ModalManager } from "components/modal_manager.slint";
import { TitleBar } from "components/title_bar.slint";
import { Sidebar } from "components/sidebar.slint";

export component AppWindow inherits Window {
    // ★ The reference writes `title: "WSA_DASHBOARD_WINDOW_UI"` literally, and
    //    so does this default. It reaches the Rust side through a property
    //    because Slint 1.17 gives no setter for a `Window`'s title -- only a
    //    getter -- so the only way to name the window from `app::runner` is to
    //    route it through something the component owns.
    in-out property <string> window_title: "WSA_DASHBOARD_WINDOW_UI";
    title: window_title;

    width: 800px;
    height: 600px;

    // The reference's window is frameless and transparent, and the *rounded*
    // rectangle you actually see is the main-layout Rectangle below, not this
    // window. Frameless without the replacement chrome would have been a
    // window with no way to move, close or minimise it, which is why P0 and P2
    // kept the system frame and why this turns on in the same change as
    // `TitleBar`.
    background: transparent;
    no-frame: true;

    // ---- home-page state (P2) ------------------------------------------------
    in property <[Distro]> distros: [];
    in property <bool> home_loading: false;
    in property <string> home_not_found_text: "";
    in property <string> home_guide_url: "";
    in property <string> home_guide_link_text: "";
    in property <bool> home_greyed: false;
    in property <bool> home_buttons_disabled: false;

    // ---- device page (P4) --------------------------------------------------
    // Property names are the reference's (`usb_*`) -- Q12 keeps identifiers as
    // it wrote them; spec section 3 renamed the *view*, not its inputs.
    in property <[DeviceTarget]> usb_targets: [];
    in property <bool> usb_loading: false;
    in property <string> usb_error: "";
    /// What the open row's properties are, as `getprop` printed them.
    /// The reference's own name for "what the info panel shows".
    in property <[DeviceProp]> usb_device_info_data: [];
    /// Which serial those belong to. Ours, and not in the reference: one
    /// dialog there knows which device it was opened for, while a page with
    /// every row open needs to be told twice.
    in property <string> usb_info_target: "";

    // ---- storage page (P5a) ------------------------------------------------
    // Spec section 3 line 241 renamed the reference's `mount_disk_view.slint` to
    // `disk_view.slint` and changed what it lists; the inputs follow the view,
    // so these are `disk_*` rather than the reference's `mounted_disks`.
    in property <[StorageImageUI]> disk_images: [];
    /// The empty state's first line plus, when there is one, the directory that
    /// was searched. Rust supplies the whole string: it knows where it looked.
    in property <string> disk_empty_note: "";
    /// What the bottom bar's primary button opens.
    in property <string> disk_folder_to_open: "";

    // ---- network page (P5b) -------------------------------------------------
    // Property names are the reference's own block (`app.slint` lines 212-237),
    // kept so a diff against it lines up (Q12). Three of the *values* are ours,
    // because three of the things they describe do not exist on this side:
    //
    //   `network_is_helper_installed: true`  the reference's is `false`, and
    //                         `false` renders "Auto-Start Forwarding". That
    //                         button installs the elevated helper `netsh
    //                         interface portproxy` needs. `adb forward` needs
    //                         no helper, so there is nothing to install and the
    //                         button is correctly absent. P7's task scheduler
    //                         is what gives that button a real job here --
    //                         re-adding mappings after a boot, which adb does
    //                         not do by itself -- and it is then set from
    //                         whether a task exists.
    //   `network_distro_names` / `network_local_ips`  declared, never read. The
    //                         reference resolves a distro's IP to forward to;
    //                         `adb forward` takes no address. They stay because
    //                         the properties are part of the reference's
    //                         `NetworkView` signature.
    //
    // `network_networking_mode` stays `"NAT"`: `adb forward` has no mode, and
    // the reference's own non-NAT branch is unreachable on a NAT system.
    in-out property <bool> network_is_admin: false;
    in-out property <bool> network_is_helper_installed: true;
    in-out property <string> network_networking_mode: "NAT";
    in-out property <[string]> network_distro_names: [];
    in-out property <[string]> network_local_ips: [];
    in-out property <[PortProxyRuleUI]> network_rules: [];
    in-out property <bool> network_proxy_is_enabled: false;
    in-out property <string> network_proxy_host: "";
    in-out property <string> network_proxy_port: "";
    in-out property <bool> network_proxy_auth_enabled: false;
    in-out property <string> network_proxy_username: "";
    in-out property <string> network_proxy_password: "";
    in-out property <string> network_proxy_no_proxy: "";
    in property <string> network_proxy_default_host: "";
    in property <string> network_proxy_default_port: "";
    in property <string> network_proxy_default_no_proxy: "";
    // ---- the network page's add-rule dialog (P5b) -------------------------
    // The reference's `show_add_network_rule` and the six `network_add_*` fields
    // it carries (`app.slint` lines 231-237), plus the two lists the dialog's
    // combo boxes read from.
    in-out property <bool> network_show_add_dialog: false;
    in-out property <int> network_add_distro_idx: 0;
    in-out property <int> network_add_ip_idx: 0;
    in-out property <string> network_add_listen_port: "";
    in-out property <string> network_add_target_port: "";
    in-out property <bool> network_add_enable_fw: true;
    in property <string> network_add_error: "";
    in-out property <bool> show_network_proxy_help: false;
    // The language picker (P6). Reference `app.slint`:164. It lives in the modal
    // state rather than in the settings block because it is a dialog flag, and
    // both the settings page and the manager bind to the same one -- so a
    // language chosen on the page and a language chosen in the picker cannot
    // drift apart into two different selections.
    in-out property <bool> show_language_dialog: false;

    // ---- install page (P4) -------------------------------------------------
    // All six are the reference's own names for the same six things on its
    // AddInstanceView, so nothing has to be translated between the two.
    in-out property <string> install_file_path;
    in property <bool> is_installing: false;
    in property <string> install_status: "";
    in property <bool> install_success: false;
    in property <string> terminal_output: "";
    in property <string> path_error: "";

    // The reference calls these task_status_* rather than home_toast_*; the
    // name is kept because the toast is a window-level overlay in the
    // reference, above every dialog, and it stays that way here.
    in property <string> task_status_text: "";
    in property <bool> task_status_visible: false;

    // ★ Q24. Two-way rather than pushed through a callback: the LineEdit owns
    // the string, so a callback would report a change that the property has
    // already recorded. The poll loop reads this back.
    in-out property <string> search_query: "";

    // ---- shell state (P3) ----------------------------------------------------
    // All names, types and defaults are the reference's (app.slint:56-74).
    in property <int> selected_tab: 0;
    in-out property <bool> sidebar_collapsed: false;
    in-out property <bool> is_maximized: false;
    in-out property <bool> is_pinned: false;
    // Whether the window is on screen. The tray hides the window rather than
    // closing it (`tray_close_to_tray`), and this is the flag the two halves agree
    // on: the close handler sets it false, the tray's double-click reads it to
    // decide which way the toggle goes. The reference has it at the same place
    // (`app.slint:74`) and with the same default.
    in-out property <bool> is_window_visible: true;

    // Which side-bar entries are offered.
    //
    // The reference defaults all of these to `true`, because it ships all nine
    // pages. Ours ships one. Turning the rest off from here -- rather than
    // inventing a "coming soon" entry or a second kind of disabled row -- is
    // the same switch the reference's settings page flips, so each later phase
    // turns one on and nothing about the mechanism changes. See MAPPING §8.
    in-out property <bool> sidebar_add: true;
    in-out property <bool> sidebar_usb: true;
    // The network page's entry, on from the start: P5b writes it, and an entry
    // that leads nowhere is the state P3 spent its own task avoiding.
    in-out property <bool> sidebar_network: true;
    in-out property <bool> sidebar_scheduler: false;
    in-out property <bool> sidebar_mount: true;
    in-out property <bool> sidebar_donate: false;
    in-out property <bool> sidebar_about: false;
    in-out property <bool> sidebar_toggle: true;

    // ---- the settings page (P6) --------------------------------------------
    // Every name, type and default is the reference's (`app.slint`:57-67, 122-137),
    // carried across whole even where this program has nothing behind the value.
    // Two of them changed what they mean rather than what they are called, and
    // the label next to each says which thing it now does -- see the block in
    // `src/i18n/mod.rs` and MAPPING 15:
    //
    //   `distro_location`  the reference picks where WSL distributions install.
    //                      Ours shows where WSA keeps its data, and the button
    //                      beside it opens that folder.
    //   `backup_location`  the reference exports instances here. Ours shows the
    //                      directory this program owns, which is the same
    //                      honest trade one level up.
    //   `sparse_vhd`       WSL's default for newly created images. Ours says
    //                      "prefer allocated size", which `disk_model` reads.
    //   `mount_auto_probe` starts a distribution so the mount table can be
    //                      read. Our storage page needs nothing running, so
    //                      this is "refresh storage when the window opens".
    //
    // `auto_shutdown`, `show_drag`, `tray_*`, `mail_icon_always`, `hide_pin`
    // and `system_color` are stored and wired as far as the phases that own
    // them allow; the last three arrive with P7.
    in-out property <string> ui_language: "en";
    in-out property <string> distro_location: "";
    in-out property <string> backup_location: "";
    in-out property <string> logs_location: "";
    in-out property <int> log_level: 4;
    in-out property <int> log_days: 7;
    in-out property <int> check_update_interval: 7;
    in-out property <bool> system_color: false;
    in-out property <bool> auto_shutdown: false;
    in-out property <bool> tray_autostart: false;
    in-out property <bool> tray_start_minimized: false;
    in-out property <bool> tray_close_to_tray: true;
    in-out property <bool> sparse_vhd: false;
    in-out property <bool> mount_auto_probe: false;
    in-out property <bool> colorful_icons: false;
    in-out property <bool> mail_icon_always: true;
    in-out property <bool> hide_pin_icon: false;
    // False, where the reference's is `true`: it has a drag-sort handle on its
    // instance list and ours is a fixed list of nine entries, so a stored `true`
    // would describe a control that is not on screen.
    in-out property <bool> show_drag: false;
    in property <SettingsStrings> settings_strings;
    /// Resolved on the Rust side, because `available_languages()` is a list of
    /// files in the binary rather than something `.slint` can enumerate.
    in property <[string]> settings_language_options;
    /// Index into `settings_language_options`, not a language code. The
    /// reference's `LanguageData.lang-codes` has "auto" at 0; ours does not, so
    /// English is 0 and the default is 0.
    in-out property <int> selected_language_index: 0;

    // ---- the about page (P6, Task 5) --------------------------------------
    // The reference's six, unchanged in name and type. `group_pic` and
    // `group_pic_ready` have nothing behind them in this build: the reference
    // downloads that image from api1.wslui.com and spec Q6 forbids calling it,
    // so `group_pic_ready` stays false and `group_clicked` does what the
    // reference's own handler does in that state -- nothing. The row is kept so
    // the page still lines up component for component; MAPPING 15 says which
    // rows have no address behind them.
    in property <AboutStrings> about_strings;
    in property <image> about_group_pic;
    in property <bool> about_group_pic_ready: false;
    in-out property <bool> show_about_group_popup: false;
    callback group_clicked();
    callback close_group_popup();
    callback check_update_clicked();

    // ---- callbacks -----------------------------------------------------------
    // P2's four, plus the shell's. The reference forwards sixteen of
    // MainView's plus its dialogs'; those land with their pages.
    callback open_url(string);
    callback start_distro(string);
    callback stop_distro(string);
    callback reorder_distros(int, int);
    callback close_task_status();
    // The device page's two. Names are the reference's `attach_clicked` /
    // `detach_clicked` (Q12); the reference's other two, `bind_clicked` and
    // `unbind_clicked`, have no counterpart here because adb has no bind step.
    callback attach_clicked(string);
    callback detach_clicked(string);
    /// Opening a row asks for that target's properties. Takes the whole target
    /// rather than a serial because the reference's info_clicked takes the
    /// whole device (Q12 keeps signatures as they were written).
    callback info_clicked(DeviceTarget);
    callback select_install_file(int);
    callback install_clicked(string);
    callback select_tab(int);
    callback home_clicked();
    // The settings page's nine, all the reference's spellings
    // (`app.slint`:1002-1024). Three of them do something here rather than what
    // they say: `stop_wsl` stops the subsystem, `open_wsl_settings` opens this
    // program's settings directory, and the three `select_*_folder` callbacks
    // open the folder each row names.
    callback save_general_settings();
    callback save_advanced_settings();
    callback save_interface_settings();
    callback select_distro_folder();
    callback select_logs_folder();
    callback select_backup_folder();
    callback open_wsl_settings();
    callback stop_wsl();
    callback language_selected(string);

    // ---- modal state (P5a) -------------------------------------------------
    // The reference's names, with the one exception noted. `show_delete_confirmation`
    // and `show_information` / `information` are its own; `package_to_delete` is
    // its `distro_to_delete`, renamed because what it holds is an Android package
    // rather than a WSL distribution -- the same substitution spec section 3 makes
    // for `usb.rs` -> `device.rs`, and recorded the same way in MAPPING.
    in-out property <bool> show_delete_confirmation: false;
    in-out property <string> package_to_delete: "";
    in property <Information> information;
    in-out property <bool> show_information: false;
    callback confirm_delete();
    callback cancel_delete();
    callback close_information();
    // The expanded action strip's three surviving buttons (spec Q22). The
    // reference declares these on `AppWindow` for its WSL cards and this program
    // had not declared them at all -- `main_view.slint` was calling callbacks
    // that nothing on the window could receive, which Slint accepts silently and
    // which is exactly why the buttons looked alive and did nothing.
    callback information_clicked(string);
    callback settings_clicked(string);
    callback delete_clicked(string);
    // Ours, not the reference's: it names a disk-mount dialog's result, and this
    // page has no dialog. Both are "open something in Explorer".
    callback disk_refresh_list();
    callback disk_open_folder(string);
    // ---- network page (P5b) -------------------------------------------------
    // The reference's names (`app.slint` lines 415-424), all of them, because
    // P9 asks the page to line up with the reference component for component.
    //
    // Three groups by what handles them:
    //
    //   wired        `delete_network_rule`, `save_proxy_settings`, and the
    //                refresh that runs when tab 3 is opened.
    //   P5b's Task 5 `open_add_rule_dialog` / `add_network_rule` (the add
    //                dialog) and `check_proxy_connection` / the help dialog.
    //   **no handler, deliberately** `process_network_rule`,
    //                `cancel_network_rule`, `apply_all_network_rules`,
    //                `cancel_all_network_rules`, `initialize_task_clicked`.
    //
    // The last group is not an unfinished wiring. Each names a step in the
    // reference's staging model, which exists because its mechanism is
    // `netsh` and needs an elevated helper: a rule is edited, sits pending, and
    // is applied afterwards in a batch. `adb forward` is an ordinary command
    // against a table that already exists -- there is no pending state to apply
    // or cancel, and `is_helper_installed: true` hides the helper button. A
    // Slint callback with no handler is a no-op, which is what these are; the
    // alternative, teaching "Cancel all rules" to do something it does not
    // name, would mislead the reader in a way silence does not. MAPPING 14.
    callback initialize_task_clicked();
    callback open_add_rule_dialog();
    callback add_network_rule(string, string, string, string, bool);
    callback delete_network_rule(string);
    callback process_network_rule(string);
    callback cancel_network_rule(string);
    callback apply_all_network_rules();
    callback cancel_all_network_rules();
    callback save_proxy_settings(bool, string, string, string, bool, string, string);
    callback check_proxy_connection(string);
    callback close_add_rule_dialog();
    callback save_sidebar_state();
    callback window_pin_toggle();
    callback window_minimize();
    callback window_maximize();
    callback window_close();
    callback window_drag_delta(float, float);
    // Rebuild the tray icon. The tray's tooltip and menu carry translated text,
    // so a language change has to rebuild it -- the reference calls this from its
    // settings handler (`settings.rs:65`), and the same `AppI18n.version` bump
    // that re-evaluates the `.slint` strings cannot reach an object that lives on
    // the Rust side.
    callback reinit_tray();
    callback toggle_theme();

    // The mail icon is suppressed in `TitleBar` (`mail_icon_always: false`):
    // the reference's is its own system-message inbox, and there is no
    // equivalent here. The property and `mail_clicked` both stay so the
    // component is untouched; nothing connects it while there is nothing to
    // connect. MAPPING §8 records the one place P3 sets "the reference has it,
    // so we have it" aside.

    // ---- Main Layout (reference app.slint:578-1056, P3's part of it) ---------
    Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.background;
        border-radius: 8px;
        clip: true;
        border-width: 1px;
        border-color: Theme.main_color;
        VerticalLayout {
            TitleBar {
                title: AppI18n.t("common.app_name", [AppI18n.version]);
                is_maximized: root.is_maximized;
                is_pinned: root.is_pinned;
                // No message source, so no icon: see above.
                mail_icon_always: false;
                pin_toggle => {
                    root.window_pin_toggle();
                }
                close => {
                    root.window_close();
                }
                minimize => {
                    root.window_minimize();
                }
                toggle_theme => {
                    Theme.dark_mode = !Theme.dark_mode;
                    root.toggle_theme();
                }
                drag_delta(dx, dy) => {
                    root.window_drag_delta(dx, dy);
                }
            }

            Rectangle {
                sidebar := Sidebar {
                    x: AppI18n.is-rtl ? parent.width - self.width : 0;
                    height: 100%;
                    collapsed <=> root.sidebar_collapsed;
                    selected_tab: root.selected_tab;
                    home_text: AppI18n.t("sidebar.home", [AppI18n.version]);
                    add_text: AppI18n.t("sidebar.add", [AppI18n.version]);
                    usb_text: AppI18n.t("sidebar.usb", [AppI18n.version]);
                    network_text: AppI18n.t("sidebar.network", [AppI18n.version]);
                    scheduler_text: AppI18n.t("sidebar.scheduler", [AppI18n.version]);
                    mount_text: AppI18n.t("sidebar.mount", [AppI18n.version]);
                    settings_text: AppI18n.t("sidebar.settings", [AppI18n.version]);
                    about_text: AppI18n.t("sidebar.about", [AppI18n.version]);
                    donate_text: AppI18n.t("sidebar.donate", [AppI18n.version]);
                    show_add: root.sidebar_add;
                    show_toggle: root.sidebar_toggle;
                    show_usb: root.sidebar_usb;
                    show_network: root.sidebar_network;
                    show_scheduler: root.sidebar_scheduler;
                    show_mount: root.sidebar_mount;
                    show_donate: root.sidebar_donate;
                    show_about: root.sidebar_about;
                    tab_selected(idx) => {
                        root.select_tab(idx);
                    }
                    home_clicked => {
                        root.home_clicked();
                    }
                    toggle_collapsed => {
                        root.save_sidebar_state();
                    }
                }

                Rectangle {
                    x: AppI18n.is-rtl ? 0 : sidebar.width;
                    width: parent.width - sidebar.width;
                    height: 100%;
                    background: Theme.content_bg;
                    border-top-left-radius: AppI18n.is-rtl ? 0 : 8px;
                    border-top-right-radius: AppI18n.is-rtl ? 8px : 0;
                    clip: true;
                    VerticalLayout {
                        padding: 16px;
                        padding-top: 8px;
                        padding-right: AppI18n.is-rtl ? 16px : 6px;
                        padding-left: AppI18n.is-rtl ? 6px : 16px;
                        Rectangle {
                            // The tab switch.
                            //
                            // Not `if selected_tab == 0`: every page is kept in the
                            // tree and the *inactive* one is moved out of the way
                            // with opacity and an x far off the left edge. Two
                            // reasons, both the reference's -- the page keeps its
                            // scroll position and its half-typed search box, and a
                            // `TouchArea` at x:10000px cannot catch a click that
                            // belongs to the page that is showing. `visible: true`
                            // is deliberate: turning it off would defeat both.
                            MainView {
                                visible: true;
                                z: 3;
                                opacity: selected_tab == 0 ? 1 : 0;
                                x: selected_tab == 0 ? 0px : 10000px;
                                distros: root.distros;
                                wsl_loading: root.home_loading;
                                distro_not_found: root.home_not_found_text;
                                distro_not_found_text: root.home_not_found_text;
                                wsl_guide_url: root.home_guide_url;
                                guide_link_text: root.home_guide_link_text;
                                greyed: root.home_greyed;
                                buttons_disabled: root.home_buttons_disabled;
                                search_query <=> root.search_query;
                                open_url(url) => {
                                    root.open_url(url);
                                }
                                start_distro(n) => {
                                    root.start_distro(n);
                                }
                                stop_distro(n) => {
                                    root.stop_distro(n);
                                }
                                reorder_distros(from, to) => {
                                    root.reorder_distros(from, to);
                                }
                                information_clicked(n) => {
                                    root.information_clicked(n);
                                }
                                settings_clicked(n) => {
                                    root.settings_clicked(n);
                                }
                                delete_clicked(n) => {
                                    root.delete_clicked(n);
                                }
                            }

                            // Tab 3 in spec section 3's table (index 2 here).
                            // `z` follows the reference's own numbering --
                            // `MainView` is z:3 and `AddInstanceView` z:4, so
                            // the view for index N sits at N + 3 -- which keeps
                            // a later tab from being painted under an earlier
                            // one while both are `visible` at once.
                            DeviceView {
                                visible: true;
                                z: 5;
                                opacity: selected_tab == 2 ? 1 : 0;
                                x: selected_tab == 2 ? 0px : 10000px;
                                targets: root.usb_targets;
                                usb_loading: root.usb_loading;
                                usb_error: root.usb_error;
                                usb_device_info_data: root.usb_device_info_data;
                                usb_info_target: root.usb_info_target;
                                attach_clicked(serial) => {
                                    root.attach_clicked(serial);
                                }
                                detach_clicked(serial) => {
                                    root.detach_clicked(serial);
                                }
                                info_clicked(t) => {
                                    root.info_clicked(t);
                                }
                            }

                            // Tab 2 in spec section 3's table (index 1 here).
                            // The reference numbers it z:4, so: 1 + 3.
                            AddInstanceView {
                                visible: true;
                                z: 4;
                                opacity: selected_tab == 1 ? 1 : 0;
                                x: selected_tab == 1 ? 0px : 10000px;
                                install_file_path <=> root.install_file_path;
                                is_installing: root.is_installing;
                                install_status: root.install_status;
                                install_success: root.install_success;
                                terminal_output: root.terminal_output;
                                path_error: root.path_error;
                                select_install_file(i) => {
                                    root.select_install_file(i);
                                }
                                install_clicked(path) => {
                                    root.install_clicked(path);
                                }
                            }

                            // Tab 6 in spec section 3's table (index 5 here):
                            // the reference's `mount_disk_view.slint`, renamed
                            // `disk_view.slint` because WSA mounts nothing.
                            // `z` follows the same rule -- 5 + 3.
                            //
                            // Instantiated in the same change that wrote it, on
                            // purpose: Slint's build only parses files reachable
                            // from `app.slint`, so a view written and left
                            // unreferenced would not fail to compile *wrong*, it
                            // would not fail at all until a later task happened
                            // to reference it. The data binding and the handlers
                            // land in the task after this one.
                            DiskView {
                                visible: true;
                                z: 8;
                                opacity: selected_tab == 5 ? 1 : 0;
                                x: selected_tab == 5 ? 0px : 10000px;
                                images: root.disk_images;
                                empty_note: root.disk_empty_note;
                                folder_to_open: root.disk_folder_to_open;
                                refresh_list => {
                                    root.disk_refresh_list();
                                }
                                open_folder(path) => {
                                    root.disk_open_folder(path);
                                }
                            }
                            // Tab 4 in spec section 3's table (index 3 here):
                            // `views/network/{mod,components,port_forwarding,
                            // http_proxy}.slint` plus `components/
                            // network_rule_card.slint`, all carried over from
                            // the reference. `z` follows the same rule as the
                            // disk page's -- tab index + 3.
                            //
                            // The view was instantiated in the task that wrote
                            // it and bound in this one, because Slint only
                            // parses files reachable from `app.slint`: an
                            // unreferenced view would not fail to compile
                            // *wrong*, it would not fail at all until something
                            // happened to mention it. Binding it now is the
                            // rest -- and everything the reference binds is
                            // bound, including the four callbacks with no
                            // handler, for why those are a deliberate no-op
                            // rather than missing wiring see their declaration.
                            NetworkView {
                                visible: true;
                                z: 6;
                                opacity: selected_tab == 3 ? 1 : 0;
                                x: selected_tab == 3 ? 0px : 10000px;
                                is_admin: root.network_is_admin;
                                is_helper_installed: root.network_is_helper_installed;
                                networking_mode: root.network_networking_mode;
                                distro_names: root.network_distro_names;
                                local_ips: root.network_local_ips;
                                rules: root.network_rules;
                                proxy_is_enabled <=> root.network_proxy_is_enabled;
                                proxy_host <=> root.network_proxy_host;
                                proxy_port <=> root.network_proxy_port;
                                proxy_auth_enabled <=> root.network_proxy_auth_enabled;
                                proxy_username <=> root.network_proxy_username;
                                proxy_password <=> root.network_proxy_password;
                                proxy_no_proxy <=> root.network_proxy_no_proxy;
                                proxy_default_host: root.network_proxy_default_host;
                                proxy_default_port: root.network_proxy_default_port;
                                proxy_default_no_proxy: root.network_proxy_default_no_proxy;
                                open_add_rule_dialog => {
                                    root.open_add_rule_dialog();
                                }
                                add_rule(distro, ip, lport, tport, fw) => {
                                    root.add_network_rule(distro, ip, lport, tport, fw);
                                }
                                delete_rule(id) => {
                                    root.delete_network_rule(id);
                                }
                                save_proxy_settings(enabled, host, port, no, auth, u, p) => {
                                    root.save_proxy_settings(enabled, host, port, no, auth, u, p);
                                }
                                show_proxy_help => {
                                    root.show_network_proxy_help = true;
                                }
                                // `open_check_proxy_dialog` is left unconnected, and
                                // the button that raises it is disabled until a proxy
                                // has been configured -- so it is not a control that
                                // silently does nothing. Its dialog sends a real
                                // request through the proxy and needs an HTTP client
                                // P8's update check brings; see MAPPING 14.
                            }
                            SettingsView {
                                visible: true;
                                z: 8;
                                opacity: selected_tab == 7 ? 1 : 0;
                                x: selected_tab == 7 ? 0px : 10000px;
                                ui_language <=> root.ui_language;
                                distro_location <=> root.distro_location;
                                backup_location <=> root.backup_location;
                                logs_location <=> root.logs_location;
                                log_level <=> root.log_level;
                                log_days <=> root.log_days;
                                check_update_interval <=> root.check_update_interval;
                                system_color <=> root.system_color;
                                auto_shutdown <=> root.auto_shutdown;
                                tray_autostart <=> root.tray_autostart;
                                tray_start_minimized <=> root.tray_start_minimized;
                                tray_close_to_tray <=> root.tray_close_to_tray;
                                sidebar_add <=> root.sidebar_add;
                                sidebar_toggle <=> root.sidebar_toggle;
                                sidebar_usb <=> root.sidebar_usb;
                                sidebar_network <=> root.sidebar_network;
                                sidebar_scheduler <=> root.sidebar_scheduler;
                                sidebar_mount <=> root.sidebar_mount;
                                sidebar_donate <=> root.sidebar_donate;
                                sidebar_about <=> root.sidebar_about;
                                sparse_vhd <=> root.sparse_vhd;
                                mount_auto_probe <=> root.mount_auto_probe;
                                colorful_icons <=> root.colorful_icons;
                                mail_icon_always <=> root.mail_icon_always;
                                hide_pin_icon <=> root.hide_pin_icon;
                                show_drag <=> root.show_drag;
                                strings: root.settings_strings;
                                language_options: root.settings_language_options;
                                selected_language_index <=> root.selected_language_index;
                                show_language_dialog <=> root.show_language_dialog;
                                save_general_settings => {
                                    root.save_general_settings();
                                }
                                save_advanced_settings => {
                                    root.save_advanced_settings();
                                }
                                save_interface_settings => {
                                    root.save_interface_settings();
                                }
                                select-distro-folder => {
                                    root.select_distro_folder();
                                }
                                select-logs-folder => {
                                    root.select_logs_folder();
                                }
                                select-backup-folder => {
                                    root.select_backup_folder();
                                }
                                open-wsl-settings => {
                                    root.open_wsl_settings();
                                }
                                stop-wsl => {
                                    root.stop_wsl();
                                }
                                language_selected(code) => {
                                    root.language_selected(code);
                                }
                            }

                            AboutView {
                                visible: true;
                                z: 9;
                                opacity: selected_tab == 8 ? 1 : 0;
                                x: selected_tab == 8 ? 0px : 10000px;
                                strings: root.about_strings;
                                group_pic: root.about_group_pic;
                                group_pic_ready: root.about_group_pic_ready;
                                show_group_popup <=> root.show_about_group_popup;
                                open_url(url) => {
                                    root.open_url(url);
                                }
                                check_update_clicked => {
                                    root.check_update_clicked();
                                }
                                group_clicked => {
                                    root.group_clicked();
                                }
                                close_group_popup => {
                                    root.close_group_popup();
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // Modal host, mounted once over every page (reference `app.slint` line 1059).
    // `z: 200` is the reference's own number, and it matters: a dialog has to be
    // above the toast as well as above the pages, or a toast raised while a
    // confirmation is up would be painted under it and look like it never fired.
    ModalManager {
        z: 200;
        show_delete: root.show_delete_confirmation;
        delete_target_name: root.package_to_delete;
        show_information: root.show_information;
        information: root.information;
        confirm_delete => {
            root.confirm_delete();
        }
        cancel_delete => {
            root.show_delete_confirmation = false;
        }
        close_information => {
            root.show_information = false;
            root.close_information();
        }
        network_distro_names: root.network_distro_names;
        network_local_ips: root.network_local_ips;
        show_add_network_rule <=> root.network_show_add_dialog;
        network_add_distro_idx <=> root.network_add_distro_idx;
        network_add_ip_idx <=> root.network_add_ip_idx;
        network_add_listen_port <=> root.network_add_listen_port;
        network_add_target_port <=> root.network_add_target_port;
        network_add_enable_fw <=> root.network_add_enable_fw;
        network_add_error: root.network_add_error;
        show_network_proxy_help <=> root.show_network_proxy_help;
        show_language_dialog <=> root.show_language_dialog;
        language_options: root.settings_language_options;
        language_current_index: root.selected_language_index;
        language_selected(code) => {
            root.language_selected(code);
        }
        add_network_rule(distro, ip, lp, tp, fw) => {
            root.add_network_rule(distro, ip, lp, tp, fw);
        }
        close_add_rule_dialog => {
            root.close_add_rule_dialog();
        }
        close_proxy_help => {
            root.show_network_proxy_help = false;
        }
    }

    // Toast notification (on top of all dialogs)
    TaskStatusToast {
        z: 100;
        opacity: root.task_status_visible ? 1 : 0;
        visible: root.task_status_visible;
        text: root.task_status_text;
        is_shown: root.task_status_visible;
        max_container_width: root.width - 40px;
        x: (root.width - self.width) / 2;
        y: root.height - self.height - 14px;
        close => {
            root.close_task_status();
        }
    }
}
