import { Theme, AppI18n, LayoutConstants } from "../theme.slint";

export component DistroNotFoundView inherits VerticalLayout {
    in property <string> guide_url: "";
    // ★ This project's delta. The reference hardcodes both strings below from
    // AppI18n, which works because it has exactly one reason to show this view
    // -- "you have no distros". This project has three (WSA not installed, WSA
    // not running, nothing installed), so the caller supplies the text; an
    // empty value keeps the reference's key lookup, and an empty guide_text
    // keeps the reference's link label. That way the default path is still the
    // reference's behaviour.
    in property <string> text: "";
    in property <string> guide_text: "";

    callback open_url(string);

    alignment: center;
    spacing: 16px;

    Text {
        text: root.text == "" ? AppI18n.t("main.distro_not_found", [AppI18n.version]) : root.text;
        color: Theme.text_secondary;
        font-family: Theme.default_font;
        font-size: 14px * LayoutConstants.font-scale;
        horizontal-alignment: center;
        wrap: word-wrap;
    }

    Rectangle {
        height: 32px;
        if (root.guide_url != ""): HorizontalLayout {
            alignment: center;
            Text {
                link_touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.open_url(root.guide_url); }
                }
                text: root.guide_text == "" ? AppI18n.t("main.guide_link", [AppI18n.version]) : root.guide_text;
                color: Theme.accent;
                font-family: Theme.default_font;
                font-size: 13px * LayoutConstants.font-scale;
                vertical-alignment: center;
            }
        }
    }
}
