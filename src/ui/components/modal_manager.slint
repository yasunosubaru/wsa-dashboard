// Ported from the reference's src/ui/components/modal_manager.slint
// (wsl-dashboard 0.12.0, GPL-3.0-only).
//
// # What this file is in the reference
//
// A dispatcher, not an abstraction. It declares one `show_*` boolean per dialog
// (about sixty of them), instantiates each dialog at `width: 100%; height: 100%`
// when its flag is set, and forwards its `confirm` / `cancel` / `close` to its
// own callbacks. Each dialog brings its own `#00000080` mask; the manager has no
// visual layer of its own, which is why it is cheap to add a dialog to and why
// there is nothing here worth refactoring into a `DialogHost`.
//
// # Why this copy has four of the sixty
//
// The reference's dialogs belong to pages this program has not built. `Settings`
// and `LanguageSelect` and `Scheduler` are P6 and P7; `CheckUpdate` and
// `Export` and `Move` are P8 and P4; `MessageMail` is the reference's own
// donation mail reader. Porting them now would mean inventing the data they
// display -- a settings model, a scheduler task list, an update payload -- for
// pages that do not exist yet, and every one of those inventions would have to
// be thrown away when the real page lands.
//
// So each phase adds its own blocks, with the reference's names and shapes, and
// the file grows toward the reference's rather than starting from a guess at it.
// P5a contributes the two that the home page's card has needed since P3 and
// could not have: the delete confirmation and the information panel. The
// `distro_card` note that said those three buttons would be wired "until P3"
// was wrong about the phase; they were waiting on this file.
//
// P5b adds the network page's add-rule dialog and its proxy help panel. Its
// third, `CheckProxyDialog`, is left out on purpose -- it sends a request
// through the proxy and needs an HTTP client P8 brings -- and a fourth family
// (26 more dialogs) waits on the pages that own them.
//
// P6 adds the language picker, which is the first of the reference's dialogs
// that has no page of its own behind it -- it is raised from the settings page
// and lands back there.
//
// P7 adds the scheduler's add/edit dialog. **The reference does not put this one
// here**: it instantiates `SchedulerDialog` directly in `app.slint`
// (`app.slint:1479`) and keeps `modal_manager.slint` for a different, larger set
// of dialogs. This copy mounts it in the manager anyway, because the manager is
// where this program has decided a dialog belongs -- one place to look, one `z`
// to reason about. The binding the reference writes at `app.slint:1483-1523` is
// therefore split: the properties and callbacks are declared here, and
// `app.slint` binds them through `ModalManager` exactly as it does the language
// picker. Nothing about the dialog itself changes.
//
// docs/MAPPING.md sections 12, 14, 15 and 16 record the subset, so P9's
// page-by-page comparison is not surprised by a 6-block manager next to a
// 60-block one.

import { Theme, AppI18n, LayoutConstants, Information } from "../theme.slint";
import { ConfirmationDialog } from "dialogs/confirmation_dialog.slint";
import { InformationDialog } from "dialogs/information_dialog.slint";
import { NetworkAddRuleDialog } from "dialogs/network_add_rule_dialog.slint";
import { ProxyHelpDialog } from "dialogs/proxy_help_dialog.slint";
import { LanguageSelectDialog } from "dialogs/language_select_dialog.slint";
import { SchedulerDialog } from "dialogs/scheduler_dialog.slint";

export component ModalManager inherits Rectangle {
    // ---- the home page's delete confirmation (reference `show_delete`) ------
    // The reference names the target `delete_target_name` and fills it from the
    // distro that was clicked. Here it is a package, and the wording comes from
    // `dialog.delete_title` / `dialog.delete_msg` with the package substituted.
    in property <bool> show_delete: false;
    in property <string> delete_target_name: "";
    callback confirm_delete();
    callback cancel_delete();

    // ---- the information panel (reference `show_information`) -------------
    in property <bool> show_information: false;
    in-out property <Information> information;
    callback close_information();

    // ---- the network page's add-rule dialog (P5b, Task 5) -----------------
    // Reference `show_add_network_rule`, and every property is the one the
    // reference declares for it, so the wiring can be diffed against
    // `modal_manager.slint` lines 601-618.
    in property <[string]> network_distro_names: [];
    in property <[string]> network_local_ips: [];
    // `in-out`, and that is not a style choice: the `<=>` two-way bindings
    // below need it, and Slint refuses to link to an input property. The
    // reference declares these the same way.
    in-out property <bool> show_add_network_rule: false;
    in-out property <int> network_add_distro_idx: 0;
    in-out property <int> network_add_ip_idx: 0;
    in-out property <string> network_add_listen_port: "";
    in-out property <string> network_add_target_port: "";
    in-out property <bool> network_add_enable_fw: true;
    in property <string> network_add_error: "";
    callback add_network_rule(string, string, string, string, bool);
    callback close_add_rule_dialog();

    // ---- the network page's proxy help panel (P5b, Task 5) ----------------
    // Reference `show_network_proxy_help`. Text only, which is why it came with
    // the add dialog and not with the connection check: see MAPPING 14 for why
    // that one waits.
    in-out property <bool> show_network_proxy_help: false;
    callback close_proxy_help();

    // ---- the language picker (P6) ------------------------------------------
    // Reference `app.slint`:164, 484-486, 970-973 and the block at
    // `modal_manager.slint`:675-688. Ours differs in one place and it is the
    // interesting one: the reference's `language_selected` takes an **index**
    // and looks the code up in `LanguageData.lang-codes`, a table hardcoded in
    // `language_data.slint` whose entry 0 is "auto". Ours takes the code
    // directly. Same reason our list is filled from `available_languages()`
    // rather than from that table: the list of languages is the list of files in
    // the binary, and a second hardcoded copy of it is a second thing to forget.
    // See MAPPING 15.
    in-out property <bool> show_language_dialog: false;
    in property <[string]> language_options: [];
    in property <int> language_current_index: 0;
    callback language_selected(string);

    // ---- the scheduler's add/edit dialog (P7) ------------------------------
    // Reference `app.slint`:243-260 and 1478-1524. Every name, type and default
    // is the reference's, and the `in-out` / `in` split follows the *dialog's*
    // own declaration (`scheduler_dialog.slint`:9-21) rather than the
    // reference's binding site -- the reference binds `task_name` and friends
    // one-way even though the dialog declares them `in-out`, and a one-way
    // binding onto a property the dialog itself assigns to would be a binding
    // the dialog immediately breaks. Two-way here, which is what `in-out`
    // means.
    //
    // The four `*_changed` callbacks exist because the handler validates as the
    // reader types: each keystroke clears or sets the matching `*_error`, and
    // the error properties above are how that answer gets back into the dialog.
    in-out property <bool> show_scheduler_dialog: false;
    in property <bool> scheduler_dialog_is_edit: false;
    in property <string> scheduler_dialog_task_id: "";
    in-out property <string> scheduler_dialog_task_name: "";
    in-out property <string> scheduler_dialog_command: "";
    in-out property <string> scheduler_dialog_arguments: "";
    in-out property <string> scheduler_dialog_cron_expr: "";
    in property <string> scheduler_dialog_cron_help_url: "";
    in property <string> scheduler_dialog_command_help_url: "";
    in property <string> scheduler_dialog_name_error: "";
    in property <string> scheduler_dialog_command_error: "";
    in property <string> scheduler_dialog_cron_error: "";
    in-out property <bool> scheduler_dialog_admin_mode: false;
    in-out property <bool> scheduler_dialog_submitting: false;
    callback close_scheduler_dialog();
    callback save_scheduler_task(string, string, string, string);
    callback browse_scheduler_command();
    callback open_scheduler_help(string);
    callback scheduler_name_changed(string);
    callback scheduler_command_changed(string);
    callback scheduler_arguments_changed(string);
    callback scheduler_cron_changed(string);

    // Every dialog is stretched over the whole window; the manager is mounted
    // once, above the pages, so a dialog covers whichever page raised it.
    if (show_delete): ConfirmationDialog {
        width: 100%;
        height: 100%;
        dialog_height: 200px;
        title_text: AppI18n.t("dialog.delete_title", [delete_target_name, AppI18n.version]);
        message: AppI18n.t("dialog.delete_msg", [delete_target_name, AppI18n.version]);
        confirm => {
            root.confirm_delete();
        }
        cancel => {
            root.cancel_delete();
        }
    }

    if (show_information): InformationDialog {
        width: 100%;
        height: 100%;
        info: root.information;
        close => {
            root.close_information();
        }
        // The reference's information dialog offers to open a WSL install
        // directory; ours has nothing to open (see the dialog's header comment),
        // so the callback is not declared. Declaring it and never raising it
        // would be an API that lies about what the dialog can do.
    }

    // P5b's two, verbatim from the reference's lines 601-618 and 638-647. The
    // third network dialog -- `CheckProxyDialog` -- is deliberately absent: it
    // sends a real request through the proxy and reports the status, which needs
    // an HTTP client this build does not have (P8's update check brings one).
    // Mounting it now would mean a button that closes a dialog and reports
    // nothing, and MAPPING 14 says when it arrives.
    if (show_add_network_rule): NetworkAddRuleDialog {
        width: 100%;
        height: 100%;
        distro_names: root.network_distro_names;
        local_ips: root.network_local_ips;
        distro_idx <=> root.network_add_distro_idx;
        ip_idx <=> root.network_add_ip_idx;
        listen_port <=> root.network_add_listen_port;
        target_port <=> root.network_add_target_port;
        enable_fw <=> root.network_add_enable_fw;
        error_msg: root.network_add_error;
        close => {
            root.close_add_rule_dialog();
        }
        add(distro, ip, lp, tp, fw) => {
            root.add_network_rule(distro, ip, lp, tp, fw);
        }
    }

    if (show_network_proxy_help): Rectangle {
        background: Theme.dark_mode ? #00000088 : #00000044;
        z: 12;
        TouchArea {
            clicked => { root.close_proxy_help(); }
        }
        ProxyHelpDialog {
            close => { root.close_proxy_help(); }
        }
    }

    if (show_language_dialog): LanguageSelectDialog {
        width: 100%;
        height: 100%;
        title: AppI18n.t("settings.language", [AppI18n.version]);
        languages: root.language_options;
        current_index: root.language_current_index;
        close => {
            root.show_language_dialog = false;
        }
        selected(code) => {
            root.language_selected(code);
            root.show_language_dialog = false;
        }
    }

    // The scheduler's add/edit dialog (P7). The reference sets `z: 100` on it at
    // `app.slint:1480`; here it inherits the manager's `z: 200`, which is above
    // the toast at `z: 100` -- the same ordering the reference gets from the two
    // numbers, reached the other way round.
    //
    // `is_edit` decides the title and whether the name field is writable; the
    // `*_error` properties are read-only inputs the handler fills in as it
    // validates; `admin_mode` and `submitting` are the two the dialog writes
    // back, which is why they are two-way.
    if (show_scheduler_dialog): SchedulerDialog {
        width: 100%;
        height: 100%;
        is_edit: root.scheduler_dialog_is_edit;
        task_id: root.scheduler_dialog_task_id;
        task_name <=> root.scheduler_dialog_task_name;
        command <=> root.scheduler_dialog_command;
        arguments <=> root.scheduler_dialog_arguments;
        cron_expr <=> root.scheduler_dialog_cron_expr;
        cron_help_url: root.scheduler_dialog_cron_help_url;
        command_help_url: root.scheduler_dialog_command_help_url;
        name_error: root.scheduler_dialog_name_error;
        command_error: root.scheduler_dialog_command_error;
        cron_error: root.scheduler_dialog_cron_error;
        admin_mode <=> root.scheduler_dialog_admin_mode;
        submitting <=> root.scheduler_dialog_submitting;
        close_clicked => {
            root.close_scheduler_dialog();
        }
        save_clicked(name, cmd, args, cron) => {
            root.save_scheduler_task(name, cmd, args, cron);
        }
        name_changed(name) => {
            root.scheduler_name_changed(name);
        }
        command_changed(cmd) => {
            root.scheduler_command_changed(cmd);
        }
        arguments_changed(args) => {
            root.scheduler_arguments_changed(args);
        }
        cron_changed(cron) => {
            root.scheduler_cron_changed(cron);
        }
        browse_clicked => {
            root.browse_scheduler_command();
        }
        cron_help_clicked => {
            root.open_scheduler_help(root.scheduler_dialog_cron_help_url);
        }
        command_help_clicked => {
            root.open_scheduler_help(root.scheduler_dialog_command_help_url);
        }
    }
}
